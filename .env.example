# Google Cloud → APIs & Services → Credentials → API key
YOUTUBE_API_KEY=your_api_key_here

# Supabase / Neon connection string, or a local Postgres URL
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Any random string. Guards /api/collect so nobody can drain your quota.
COLLECT_SECRET=change_me_to_something_random

# Optional: base URL used by the GitHub Actions collector
APP_URL=https://your-app.vercel.app
